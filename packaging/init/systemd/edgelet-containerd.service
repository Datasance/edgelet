# Edgelet embedded containerd (data plane) — stub for Plan 11 workload continuity.
# Plan 11 fills ExecStart (runtime-bootstrap), cgroup bootstrap, and MS lifecycle.
[Unit]
Description=Edgelet embedded containerd (data plane)
Documentation=https://github.com/datasance/edgelet
PartOf=edgelet.service
Before=edgelet.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Plan 11: ExecStart=/usr/local/bin/edgelet runtime-bootstrap
ExecStart=/bin/true
ExecStop=/bin/true

[Install]
WantedBy=multi-user.target
