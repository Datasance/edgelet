#!/sbin/openrc-run

name="edgelet"
description="Edgelet daemon"
command="/usr/local/bin/edgelet"
command_args="daemon"
command_background=true
command_user="root"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/edgelet/daemon.log"
error_log="/var/log/edgelet/daemon.log"

depend() {
    need net
    after firewall
}
