[Unit]
Description=ioFog Agent Daemon
Documentation=https://github.com/eclipse-iofog/agent
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
ExecStart=/usr/local/bin/iofog-agentd start
Restart=always
RestartSec=2s
TimeoutStopSec=120s
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
User=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iofog-agentd

# Security settings
NoNewPrivileges=no
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/iofog-agent /var/lib/iofog-agent /var/lib/iofog-agent-containerd /var/log/iofog-agent /run/iofog-agent /var/backups/iofog-agent

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
