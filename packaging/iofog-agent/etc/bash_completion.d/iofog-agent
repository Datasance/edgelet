_iofog-agent()
{
	local cur prev opts base
	COMPREPLY=()
	cur="${COMP_WORDS[COMP_CWORD]}"
	prev="${COMP_WORDS[COMP_CWORD-1]}"
	opts="--help --version -h -? -v help version status provision deprovision info config switch cert prune"
	
	case "${prev}" in
		config)
			;;
		provision)
			;;
		switch)
			COMPREPLY=($(compgen -W "default development production dev prod def" -- ${cur}))
			return 0
			;;
		cert)
			;;
		*)
			;;
	esac


	COMPREPLY=($(compgen -W "${opts}" -- ${cur}))  
	return 0
}
complete -F _iofog-agent iofog-agent
