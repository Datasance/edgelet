#!/bin/bash
# Build edgelet multicall binaries for release/CI.
# Usage:
#   ARCH=amd64 ./scripts/build-edgelet              # unified linux thin (needs embed)
#   ARCH=amd64 ./scripts/build-edgelet fat          # fat runtime -> build/bin/edgelet
#   EDGELET_CI_ARCHES=amd64,arm64 ./scripts/build-edgelet
# Static embed is the default (Plan 10-8 — musl/glibc portable Linux).
# Opt out for fast local iteration: STATIC_BUILD=false ARCH=amd64 ./scripts/build-edgelet
# Desktop (optional): EDGELET_DESKTOP=true ./scripts/build-edgelet

set -e

cd "$(dirname "$0")/.."

. ./scripts/version.sh
# shellcheck source=scripts/embed-static-default.sh
. ./scripts/embed-static-default.sh

GO=${GO-go}
VERSION=${VERSION:-$(git describe --tags --always --dirty 2>/dev/null || echo dev)}
BUILD_TIME=$(date -u '+%Y-%m-%d_%H:%M:%S')
GIT_COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo unknown)

PKG=github.com/datasance/edgelet
LDFLAGS_BASE="-s -w \
  -X main.version=${VERSION} \
  -X main.buildTime=${BUILD_TIME} \
  -X main.gitCommit=${GIT_COMMIT} \
  -X ${PKG}/internal/cli/cmd.Version=${VERSION} \
  -X ${PKG}/internal/cli/cmd.BuildTime=${BUILD_TIME} \
  -X ${PKG}/internal/cli/cmd.GitCommit=${GIT_COMMIT} \
  -X ${PKG}/internal/version.Version=${VERSION} \
  -X ${PKG}/internal/version.BuildTime=${BUILD_TIME} \
  -X ${PKG}/internal/version.GitCommit=${GIT_COMMIT}"

STATIC_LDFLAGS=""
STATIC_TAGS=""
if [ "${EMBED_STATIC_BUILD}" = "true" ]; then
  STATIC_LDFLAGS=' -extldflags "-static -lm -ldl -lz -lpthread"'
  STATIC_TAGS="static_build"
fi

mkdir -p build dist build/bin

cc_for_arch() {
  _target="$1"
  _host=$(uname -m)
  case "${_target}" in
    amd64)
      if [ "${_host}" = "x86_64" ]; then
        echo "${CC:-gcc}"
      else
        echo "${CC:-x86_64-linux-gnu-gcc}"
      fi
      ;;
    arm64)
      if [ "${_host}" = "aarch64" ]; then
        echo "${CC:-gcc}"
      else
        echo "${CC:-aarch64-linux-gnu-gcc}"
      fi
      ;;
    arm) echo "${CC:-arm-linux-gnueabihf-gcc}" ;;
    riscv64) echo "${CC:-riscv64-linux-gnu-gcc}" ;;
    *) echo "ERROR: unsupported ARCH ${_target}" >&2; return 1 ;;
  esac
}

build_fat_runtime() {
  _arch="$1"
  _goarch="$_arch"
  _goarm=""
  _cc=""

  case "${_arch}" in
    arm)
      _goarch=arm
      _goarm=7
      ;;
    amd64|arm64|riscv64)
      ;;
    *)
      echo "ERROR: unsupported ARCH ${_arch}" >&2
      exit 1
      ;;
  esac

  _cc=$(cc_for_arch "${_arch}")
  _out="build/bin/edgelet"
  _ldflags="${LDFLAGS_BASE}${STATIC_LDFLAGS}"

  echo "Building edgelet fat runtime linux/${_arch} (CC=${_cc}) -> ${_out}"
  CGO_ENABLED=1 GOOS=linux GOARCH="${_goarch}" GOARM="${_goarm}" CC="${_cc}" \
    "${GO}" build -trimpath -ldflags "${_ldflags}" -tags "cgo ${STATIC_TAGS}" -o "${_out}" ./cmd/edgelet-server
}

build_linux_thin() {
  _arch="$1"
  _goarch="$_arch"
  _goarm=""
  _out="build/edgelet-linux-${_arch}"

  case "${_arch}" in
    arm)
      _goarch=arm
      _goarm=7
      ;;
    amd64|arm64|riscv64)
      ;;
    *)
      echo "ERROR: unsupported ARCH ${_arch}" >&2
      exit 1
      ;;
  esac

  _embed_count=$(find pkg/data/embed -name '*.tar.zst' 2>/dev/null | wc -l | tr -d ' ')
  if [ "${_embed_count}" -eq 0 ]; then
    echo "ERROR: no embed bundle in pkg/data/embed (run scripts/package-data after fat build)" >&2
    exit 1
  fi

  _ldflags="${LDFLAGS_BASE}${STATIC_LDFLAGS}"
  echo "Building edgelet linux/${_arch} thin -> ${_out}"
  CGO_ENABLED=0 GOOS=linux GOARCH="${_goarch}" GOARM="${_goarm}" \
    "${GO}" build -trimpath -ldflags "${_ldflags}" -tags "${STATIC_TAGS}" -o "${_out}" ./cmd/edgelet
}

build_desktop() {
  _goos="$1"
  _goarch="$2"
  _goarm="${3:-}"
  _suffix="${_goos}-${_goarch}"
  if [ -n "${_goarm}" ]; then
    _suffix="${_goos}-${_goarch}v${_goarm}"
  fi
  _out="build/edgelet-${_suffix}"
  if [ "${_goos}" = windows ]; then
    _out="${_out}.exe"
  fi
  _ldflags="${LDFLAGS_BASE}${STATIC_LDFLAGS}"
  echo "Building edgelet ${_goos}/${_goarch} -> ${_out}"
  CGO_ENABLED=0 GOOS="${_goos}" GOARCH="${_goarch}" GOARM="${_goarm}" \
    "${GO}" build -trimpath -ldflags "${_ldflags}" -tags "${STATIC_TAGS}" -o "${_out}" ./cmd/edgelet
}

MODE="${1:-all}"
ARCHES="${EDGELET_CI_ARCHES:-${ARCH:-amd64}}"
IFS=',' read -r -a _arch_list <<< "${ARCHES}"

case "${MODE}" in
  fat)
    for _arch in "${_arch_list[@]}"; do
      _arch=$(echo "${_arch}" | tr -d ' ')
      [ -n "${_arch}" ] || continue
      build_fat_runtime "${_arch}"
    done
    ;;
  all|"")
    for _arch in "${_arch_list[@]}"; do
      _arch=$(echo "${_arch}" | tr -d ' ')
      [ -n "${_arch}" ] || continue
      build_linux_thin "${_arch}"
    done
    if [ "${EDGELET_DESKTOP:-}" = "true" ]; then
      build_desktop darwin amd64
      build_desktop darwin arm64
      build_desktop windows amd64
    fi
    ;;
  *)
    echo "ERROR: unknown mode ${MODE} (use: fat | all)" >&2
    exit 1
    ;;
esac

echo "build-edgelet complete"
