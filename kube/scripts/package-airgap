#!/bin/bash
# Export the pinned image list as edgelet-kube-airgap-images-amd64.tar.zst.
# The archive is published beside the amd64 binary. It is not part of the runtime.
set -euo pipefail

cd "$(dirname "$0")/.."
export GOWORK=off

arch="${ARCH:-amd64}"
if [ "$arch" != "amd64" ]; then
	echo "package-airgap: only amd64 is built" >&2
	exit 1
fi

out="${OUT:-build/edgelet-kube-airgap-images-amd64.tar.zst}"
case "$(basename "$out")" in
edgelet-kube-airgap-images-amd64.tar.zst) ;;
*)
	echo "package-airgap: asset must be edgelet-kube-airgap-images-amd64.tar.zst" >&2
	exit 1
	;;
esac

out_abs="$out"
case "$out_abs" in
/*) ;;
*) out_abs="$(pwd)/$out_abs" ;;
esac
embed="$(pwd)/cmd/edgelet-kube/embed/"
case "$out_abs" in
"$embed"*)
	echo "package-airgap: the archive is published beside the binary" >&2
	exit 1
	;;
esac

ctr="${CTR:-ctr}"
list="scripts/airgap/image-list.txt"
images=()
while IFS= read -r line || [ -n "$line" ]; do
	line="${line#"${line%%[![:space:]]*}"}"
	line="${line%"${line##*[![:space:]]}"}"
	[ -z "$line" ] && continue
	case "$line" in
	\#*) continue ;;
	esac
	images+=("$line")
done < "$list"
if [ "${#images[@]}" -ne 12 ]; then
	echo "package-airgap: the pin list has ${#images[@]} images" >&2
	exit 1
fi

mkdir -p "$(dirname "$out")"
"$ctr" namespaces create k8s.io >/dev/null 2>&1 || true
platform="--platform=linux/amd64"
for image in "${images[@]}"; do
	"$ctr" -n k8s.io images pull "$platform" "$image"
done

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
"$ctr" -n k8s.io images export "$platform" "$tmp" "${images[@]}"
go run ./scripts/airgap/zstdcmd -in "$tmp" -out "$out"

listed="$(go run ./scripts/airgap/zstdcmd -list "$out")"
want="$(printf '%s\n' "${images[@]}")"
if [ "$listed" != "$want" ]; then
	echo "package-airgap: archive image names do not match the pin list" >&2
	exit 1
fi
